{
  "name": "thrall-web",
  "private": true,
  "version": "0.2.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "licences": "node scripts/licences.mjs",
    "gen:types": "json2ts -i ../docs/protocol.schema.json -o src/protocol.ts --additionalProperties false --bannerComment \"/* Generated from docs/protocol.schema.json by npm run gen:types. Do not edit. */\""
  },
  "dependencies": {
    "@fontsource/doto": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
